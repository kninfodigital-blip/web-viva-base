{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build.py",
  "outputDirectory": "dist",
  "framework": null,
  "routes": [
    {
      "src": "^/(.+)/$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "^/(.*)$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "headers": {
        "Link": "</llms.txt>; rel=\"describedby\"; type=\"text/markdown\", </index.md>; rel=\"alternate\"; type=\"text/markdown\", </.well-known/ard.json>; rel=\"ard\"; type=\"application/json\", </.well-known/ai-catalog.json>; rel=\"ai-catalog\"; type=\"application/json\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\"",
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "^/assets/fonts/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "^/assets/img/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=2592000, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "^/(.*)\\.md$",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "^/llms\\.txt$",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "^/\\.well-known/(ard|ai-catalog)\\.json$",
      "headers": {
        "Content-Type": "application/ai-catalog+json; charset=utf-8",
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=3600"
      },
      "continue": true
    },
    {
      "src": "^/\\.well-known/(.*)$",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "^/robots\\.txt$",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "^/sitemap\\.xml$",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/index.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/servicios$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/servicios.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/servicios$",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "^/sobre\\-nosotros$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/sobre-nosotros.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/sobre\\-nosotros$",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "^/zona$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/zona.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/zona$",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "^/contacto$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/contacto.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/contacto$",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "^/aviso\\-legal$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/aviso-legal.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/aviso\\-legal$",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "^/privacidad$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/privacidad.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/privacidad$",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "^/ca$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/ca/index.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/ca$",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "^/ca/servicios$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/ca/servicios.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/ca/servicios$",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "^/ca/sobre\\-nosotros$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/ca/sobre-nosotros.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/ca/sobre\\-nosotros$",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "^/ca/zona$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/ca/zona.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/ca/zona$",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "^/ca/contacto$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/ca/contacto.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/ca/contacto$",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "^/ca/aviso\\-legal$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/ca/aviso-legal.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/ca/aviso\\-legal$",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "^/ca/privacidad$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/ca/privacidad.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/ca/privacidad$",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    }
  ]
}
